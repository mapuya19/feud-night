{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feud-server",
  "main": "src/router.ts",
  "compatibility_date": "2024-12-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "FeudRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FeudRoom"]
    }
  ]
}
