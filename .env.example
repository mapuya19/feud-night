# WebSocket base URL of the Cloudflare Worker (game server).
# Dev (this laptop): ws://localhost:8787
# Phones on Wi-Fi:   ws://<laptop-LAN-IP>:8787 (bind wrangler to 0.0.0.0)
# Production:        wss://feud-server.<your-subdomain>.workers.dev
# Public/build-time setting: restart dev or redeploy after changing it.
NEXT_PUBLIC_WS_URL=ws://localhost:8787

# Absolute origin of the deployed Next.js app, used for join links / QR codes.
# Optional: defaults to the current frontend origin. No trailing slash.
# For local phones use http://<laptop-LAN-IP>:3000, not localhost.
NEXT_PUBLIC_SITE_URL=
