# WebSocket base URL of the Cloudflare Worker (game server).
# Dev (wrangler):    ws://localhost:8787
# Production:        wss://feud-server.<your-subdomain>.workers.dev
NEXT_PUBLIC_WS_URL=ws://localhost:8787

# Absolute origin of the deployed Next.js app, used for join links / QR codes.
# Optional in dev. Example: https://feud-night.vercel.app
NEXT_PUBLIC_SITE_URL=
